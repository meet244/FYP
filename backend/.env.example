# Copy to .env and fill in.

# --- LLM (notes, syllabus parsing, chat) ---
ANTHROPIC_API_KEY=
CLASSSCRIBE_LLM_MODEL=claude-opus-5

# --- ASR ---
# mlx (Apple silicon, matches the paper) | faster-whisper (everything else)
CLASSSCRIBE_ASR_BACKEND=mlx
CLASSSCRIBE_ASR_MODEL=mlx-community/whisper-large-v3-turbo
CLASSSCRIBE_ASR_LANGUAGE=hi

# --- SGCD ---
# Section V-D: conditioning only works on lecture-length spans. Do not lower.
CLASSSCRIBE_SPAN_TARGET_S=25.0
CLASSSCRIBE_RETRIEVAL_K=3
CLASSSCRIBE_PROMPT_MAX_TOKENS=200
# Stability safeguard. Thresholds do NOT transfer across checkpoints — refit per model.
CLASSSCRIBE_SAFEGUARD_ENABLED=true
CLASSSCRIBE_SAFEGUARD_D_LOGPROB=0.25
CLASSSCRIBE_SAFEGUARD_MAX_CR=2.0
CLASSSCRIBE_SAFEGUARD_LEN_RATIO=1.5

# --- storage ---
CLASSSCRIBE_DATA_DIR=./data
CLASSSCRIBE_DB_URL=sqlite:///./data/classscribe.db

# --- embeddings ---
CLASSSCRIBE_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
